<div class="lead-preview" data-lead-preview>
    <p class="lead-preview-label">Housecall Pro · Preview only</p>
    <p class="form-note">This is a layout sample. The published form will send requests to Bremray’s Housecall Pro inbox. Nothing can be entered or sent here.</p>
    <fieldset disabled aria-label="Non-interactive sample of the Housecall Pro form">
        <legend>Contact details</legend>
        <div class="lead-preview-row">
            <label>First name<input type="text" autocomplete="off"></label>
            <label>Last name<input type="text" autocomplete="off"></label>
        </div>
        <label>Phone number<input type="tel" autocomplete="off"></label>
        <label>Email<input type="email" autocomplete="off"></label>
        <label>Street address<input type="text" autocomplete="off"></label>
        <div class="lead-preview-row">
            <label>City<input type="text" autocomplete="off"></label>
            <label>State and ZIP<input type="text" autocomplete="off"></label>
        </div>
        <label>Service details<textarea rows="4" placeholder="What would you like installed, or what isn’t working?"></textarea></label>
        <p class="form-note">The Housecall Pro form includes a separate marketing text-message choice.</p>
        <button type="button" class="button dark" disabled>Contact us · Preview only</button>
    </fieldset>
</div>
