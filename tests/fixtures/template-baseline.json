  "ev-charger-installation.html": {
    "metadata": [
      "\u003ctitle\u003eEV Charger Installation in Ann Arbor | Bremray Electrical\u003c/title\u003e",
      "\u003cmeta name=\"description\" content=\"Need an EV charger at home? Bremray installs home charging in Ann Arbor and Washtenaw County. Tell us what you drive and where you park to get started.\"\u003e",
      "\u003clink rel=\"canonical\" href=\"https://bremray.com/ev-charger-installation.html\" /\u003e",
      "\u003cmeta property=\"og:type\" content=\"article\"\u003e",
      "\u003cmeta property=\"og:site_name\" content=\"Bremray Electrical\"\u003e",
      "\u003cmeta property=\"og:title\" content=\"EV Charger Installation in Ann Arbor | Bremray Electrical\"\u003e",
      "\u003cmeta property=\"og:description\" content=\"Need an EV charger at home? Bremray installs home charging in Ann Arbor and Washtenaw County. Tell us what you drive and where you park to get started.\"\u003e",
      "\u003cmeta property=\"og:url\" content=\"https://bremray.com/ev-charger-installation.html\"\u003e",
      "\u003cmeta property=\"og:image\" content=\"https://bremray.com/images/logo.png\"\u003e"
    ],
    "schemas": [
      "\u003cscript type=\"application/ld+json\"\u003e\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://bremray.com/\"},\n        {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"EV Charger Installation\", \"item\": \"https://bremray.com/ev-charger-installation.html\"}\n      ]\n    }\n    \u003c/script\u003e",
      "\u003cscript type=\"application/ld+json\"\u003e\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Should I install a larger circuit for my next car?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Tell us what you might buy next. We can compare preparing the wiring now with keeping this installation smaller. A larger circuit only helps if your home and charging equipment can use it.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I use the dryer outlet?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Ask us to check it first. The outlet, wiring, circuit rating, and charger must match. Sharing a circuit may need approved load management equipment. Don't assume a plug adapter makes it suitable.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can you install a charger in a detached garage?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. We check the power already available in the garage and the route for any new wiring. Underground work can affect the price.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do I need to buy the charger first?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"No. Tell us about your car and where you park. We can help you choose before you buy, or install suitable equipment you already own.\"\n      }\n    }\n  ]\n}\n\u003c/script\u003e",
      "\u003cscript type=\"application/ld+json\"\u003e\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Electrician\",\n      \"@id\": \"https://bremray.com/#business\",\n      \"name\": \"Bremray Electrical\",\n      \"url\": \"https://bremray.com/\",\n      \"logo\": \"https://bremray.com/images/logo.png\",\n      \"image\": \"https://bremray.com/images/logo.png\",\n      \"telephone\": \"+1-734-216-9437\",\n      \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Ann Arbor\", \"addressRegion\": \"MI\", \"postalCode\": \"48103\"}\n    }\n    \u003c/script\u003e"
    ],
