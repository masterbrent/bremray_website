    {
      "@type": "Question",
      "name": "Can I use the dryer outlet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ask us to check it first. The outlet, wiring, circuit rating, and charger must match. Sharing a circuit may need approved load management equipment. Don't assume a plug adapter makes it suitable."
      }
    },
    {
      "@type": "Question",
      "name": "Can you install a charger in a detached garage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We check the power already available in the garage and the route for any new wiring. Underground work can affect the price."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to buy the charger first?",
      "acceptedAnswer": {
        "@type": "Answer",
